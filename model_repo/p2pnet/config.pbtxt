name: "p2pnet"
platform: "onnxruntime_onnx"
default_model_filename: "model.onnx"
max_batch_size: 0

input: [
    {
        name: "input"
        data_type: TYPE_FP32
        dims: [ 1, 3, 336, 336 ]
    }
]

output: [
    {
        name: "output"
        data_type: TYPE_FP32
        dims: [ 1, 7056, 2]
    },
    {
        name: "263"
        data_type: TYPE_FP32
        dims: [ 1, 7056, 2]
    }
]